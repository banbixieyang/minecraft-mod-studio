        { "key": "id", "label": "标识符", "type": "id", "required": true, "hint": "如 ruby。同时决定贴图文件名" },
        { "key": "nameZh", "label": "中文名", "type": "text", "required": true, "placeholder": "红宝石" },
        { "key": "nameEn", "label": "英文名", "type": "text" },
        { "key": "durability", "label": "耐久基数", "type": "number", "default": 33, "min": 1, "hint": "钻石 33，下界合金 37。会按部位乘以不同系数" },
        { "key": "defHelmet", "label": "头盔防御", "type": "number", "default": 3, "min": 0, "max": 20 },
        { "key": "defChest", "label": "胸甲防御", "type": "number", "default": 8, "min": 0, "max": 20 },
        { "key": "defLegs", "label": "护腿防御", "type": "number", "default": 6, "min": 0, "max": 20 },
