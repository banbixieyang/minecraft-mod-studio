            { "value": "undead", "label": "亡灵绿" },
            { "value": "ender", "label": "末影紫" },
            { "value": "void", "label": "虚空黑紫" },
            { "value": "emerald", "label": "翠绿" },
            { "value": "amber", "label": "琥珀" },
            { "value": "ice", "label": "冰蓝" },
            { "value": "blood", "label": "血红" },
            { "value": "copper", "label": "古铜" },
            { "value": "shadow", "label": "暗影" },
            { "value": "stone", "label": "原色（几乎不改）" }
          ]
        },
        { "key": "repairItems", "label": "维修材料", "type": "list", "hint": "每行一个物品 id" }
      ]
    }
  ]
}
