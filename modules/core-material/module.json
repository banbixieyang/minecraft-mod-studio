        { "key": "toughness", "label": "韧性", "type": "number", "default": 2, "step": 0.5, "hint": "钻石 2，下界合金 3。降低高伤害攻击的穿透" },
        { "key": "knockbackResistance", "label": "击退抗性", "type": "number", "default": 0, "step": 0.05, "min": 0, "max": 1 },
