# ── 测试生成的工程（本地工作区）────────────────────
# 每个工程都有 .gradle/（含 37MB 的 Minecraft 合并 jar）和 build/，
# 全部是构建缓存与产物，不进版本库。
projects/

# ── 浏览器测试产物 ────────────────────────────────
# 截图有参考价值，但浏览器 profile 是缓存，只留图不留缓存。
tests/artifacts/.profile/
tests/artifacts/.browser-profile/

# ── 本地临时文件 ──────────────────────────────────
an.json
.tmp/
tmp_*/

# ── 编辑器与系统 ──────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 用户数据 ──────────────────────────────────────
