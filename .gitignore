# ── 依赖与构建产物 ────────────────────────────────
node_modules/
dist/
*.log

# build/ 一律不提交 —— 但 core/build/ 是引擎源码（Gradle 集成），
# 不能一起排除，否则 clone 下来直接起不来。
# 规则按层级精确锚定，不写裸 build/：
#   裸 build/ 会在任何层级匹配，会连源码目录 core/build/ 一起误伤。
/build/
projects/*/build/
!core/build/

# ── 测试生成的工程（本地工作区）────────────────────
# 每个工程都有 .gradle/（含 37MB 的 Minecraft 合并 jar）和 build/，
# 全部是构建缓存与产物，不进版本库。
projects/

# ── 浏览器测试产物 ────────────────────────────────
# 截图有参考价值，但浏览器 profile 是缓存，只留图不留缓存。
tests/artifacts/.profile/
tests/artifacts/.browser-profile/

# ── 本地临时文件 ──────────────────────────────────
an.json
.tmp/
tmp_*/

# ── 编辑器与系统 ──────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 用户数据 ──────────────────────────────────────
# 导入的 mod jar、导出的包、知识库索引都在用户主目录，
# 不应该也不需要进仓库。
*.mcpkg.json

# ── 拆解产物（本地工作输出）───────────────────────
# 分析别人 mod 生成的预览/报告，是一次性的工作产物，
# 不是 MC Studio 的源码，也不该替第三方 mod 再发布一次。
# 文件保留在本地，只是不进版本库。
Goety*.html
Goety*.md
